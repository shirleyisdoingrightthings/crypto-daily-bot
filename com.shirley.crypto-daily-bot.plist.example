<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
    配置模板：复制为 ~/Library/LaunchAgents/com.shirley.crypto-daily-bot.plist 并填入真实值。

    ⚠️ 本 plist 不承担任何调度职责（2026-07-20 移除了 09:15 launchd 兜底，
    失败兜底由 09:45 health_check + auto_repair 承担）。它只是环境变量的
    唯一权威配置源：claude_report.sh 通过 PlistBuddy 从 EnvironmentVariables
    读取密钥/代理，08:30 Claude 定时任务依赖它。ProgramArguments 固定为
    /usr/bin/true，仅为满足 launchd 对 plist 结构的要求，永远不会被触发。
-->
<dict>
    <key>Label</key>
    <string>com.shirley.crypto-daily-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/true</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- ⚠️ 飞书自定义机器人 webhook：群「设置 → 群机器人 → 添加机器人
             → 自定义机器人」里取得，形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxx -->
        <key>FEISHU_WEBHOOK</key>
        <string>YOUR_FEISHU_WEBHOOK_URL</string>

        <!-- 只有在添加机器人时勾了「签名校验」才需要填，没勾就留空字符串 -->
        <key>FEISHU_SECRET</key>
        <string></string>

        <key>COINGECKO_API_KEY</key>
        <string>YOUR_COINGECKO_KEY_HERE</string>

        <!-- 本地代理地址：只有抓取 RSS/行情时需要，推送飞书是直连 -->
        <key>HTTPS_PROXY</key>
        <string>http://127.0.0.1:YOUR_PORT</string>
        <key>HTTP_PROXY</key>
        <string>http://127.0.0.1:YOUR_PORT</string>
    </dict>
</dict>
</plist>
